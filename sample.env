# Copy this to .env and fill it in. .env is never committed.
#
# TEAM_ID  Your Apple developer team id, ten characters.
#          A finder extension must be sandboxed, and a sandboxed extension can only
#          reach the app when both are signed by the same team, so the build needs it.
#          Find yours with:
#            security find-identity -v -p codesigning
#            security find-certificate -c "Apple Development: YOUR NAME (XXXXXXXXXX)" -p \
#              | openssl x509 -noout -subject
#          The OU= field is your team id.
TEAM_ID=
